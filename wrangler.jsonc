// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Deploys at `api-hop.<account-subdomain>.workers.dev`.
  //
  // The requested address was `api.hop.rewindly.workers.dev`, and that shape is
  // not reachable this way: a workers.dev address is
  // `<script-name>.<account-subdomain>.workers.dev`, and the script-name
  // segment is a single DNS label with no dots in it. A dotted hostname like
  // `api.hop.rewindly.<yourdomain>` needs the apex zone on this Cloudflare
  // account plus a Custom Domain or Route pointed at this Worker -- a different
  // mechanism entirely, and the README says so.
  "name": "api-hop",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },

  "placement": { "mode": "off" },

  // The source of truth for per-key, per-model usage. A Durable Object and not
  // KV: two concurrent requests must not both read the same "has headroom" on a
  // key with one request of headroom left. See src/quota_broker.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_BROKER",
        "class_name": "QuotaBroker"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuotaBroker"]
    }
  ]

  // Secrets, set with `wrangler secret put <NAME>` and never in this file:
  //   GEMINI_API_KEYS       JSON array of { id, key }
  //   INCEPTION_API_KEYS    same shape; optional Mercury overflow for text intents
  //   HOP_GATEWAY_API_KEY   the one key every caller presents
  //
  // Optional Cloudflare AI Gateway vars (free logging/analytics; unset means
  // calls go straight to Google):
  //   CLOUDFLARE_ACCOUNT_ID, AI_GATEWAY_NAME, CF_AIG_TOKEN
}
